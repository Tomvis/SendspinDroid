<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider path configuration for sharing debug logs.
    Only exposes the debug_logs subdirectory in cache.
-->
<paths>
    <!-- Debug logs in app cache directory -->
    <cache-path name="debug_logs" path="." />
    <!-- Fork (HW-301): logs moved to the external files dir so adb can pull them -->
    <external-files-path name="debug_logs_ext" path="logs/" />
</paths>
