<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12 and higher
    (android:dataExtractionRules). Android 11 and lower reads backup_rules.xml;
    keep the two in step. See that file for why these two are excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sendspin_secure_prefs.xml" />
        <exclude domain="sharedpref" path="sendspin_plain_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sendspin_secure_prefs.xml" />
        <exclude domain="sharedpref" path="sendspin_plain_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
